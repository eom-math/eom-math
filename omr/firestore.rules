// ─────────────────────────────────────────────────────────────
// 모바일 OMR용 Firestore 보안 규칙 (추가분)
//
// 적용 방법: Firebase 콘솔 → Firestore Database → 규칙 탭에서
//   기존 `match /databases/{database}/documents { ... }` 블록 "안쪽"에
//   아래 function / match 들을 붙여 넣고 게시하세요. 기존 규칙(towerScores 등)은 그대로 둡니다.
//
// ⚠ ADMIN_EMAIL 을 관리자 로그인에 쓰는 이메일로 바꾸세요.
//   (Firebase 이메일 로그인은 누구나 계정을 만들 수 있어서, "로그인했는지"만으로는
//    학부모 연락처가 든 학생 명단을 보호할 수 없습니다.)
// ─────────────────────────────────────────────────────────────

    function omrAdmin() {
      return request.auth != null && request.auth.token.email == 'ADMIN_EMAIL';
    }
    // 선생님 또는 조교(omrStaff에 등록된 계정)
    function omrStaffOrAdmin() {
      return omrAdmin() || (request.auth != null
        && exists(/databases/$(database)/documents/omrStaff/$(request.auth.uid)));
    }

    // 학생 명단 (연락처 포함) — 관리자만
    match /omrStudents/{id} {
      allow read, write: if omrAdmin();
    }

    // 학생 상담 기록·학교 성적 (중간·기말·모의고사). 민감 정보라 선생님(관리자)만
    match /studentCounsel/{id} {
      allow read, write: if omrAdmin();
    }
    match /studentScores/{id} {
      allow read, write: if omrAdmin();
    }

    // 칭찬 공지 (메인 화면 칭찬 게시판). 누구나 읽기, 선생님만 쓰기
    match /notices/{id} {
      allow read: if true;
      allow write: if omrAdmin();
    }

    // 수업 달력: 반별 정규 수업 시간 · 휴강/직보/시험기간 일정. 누구나 읽기, 선생님만 쓰기
    match /classSchedules/{id} {
      allow read: if true;
      allow write: if omrAdmin();
    }
    match /classEvents/{id} {
      allow read: if true;
      allow write: if omrAdmin();
    }

    // 학생이 직접 넣는 '내 일정' (학생 코드 문서 하나). 선생님 일정(classEvents)은 관리자만 씀
    match /studentCal/{code} {
      allow get: if true;
      allow list: if omrAdmin();
      allow write: if omrAdmin() || (exists(/databases/$(database)/documents/omrCodes/$(code))
        && request.resource.data.keys().hasOnly(['items','updatedAt'])
        && request.resource.data.items is list && request.resource.data.items.size() <= 300);
    }

    // 메인 게시판: 공지(관리자) + 학생 글
    //  public 공개(이름 가림) · anon 익명(학생 정보 없음) · teacher 선생님께(관리자만) · staff 조교 선생님께(조교+관리자)
    //  선생님께·조교께 글은 목록 조회 불가, 글 id(추측 불가)로만 열림. 누가 썼는지는 boardAuthors(관리자만 읽음)
    match /boardPosts/{id} {
      function postOk() {
        let d = request.resource.data;
        let au = /databases/$(database)/documents/boardAuthors/$(id);
        return d.kind == 'post'
          && d.keys().hasOnly(['kind','title','body','visibility','sid','nick','className','createdAt'])
          && d.visibility in ['public','anon','teacher','staff']
          && d.title is string && d.title.size() >= 1 && d.title.size() <= 60
          && d.body is string && d.body.size() <= 3000
          && d.createdAt == request.time
          && existsAfter(au)
          && (d.visibility == 'anon'
              ? (!('sid' in d) && !('className' in d) && d.nick == '익명')
              : (d.sid is string && getAfter(au).data.sid == d.sid
                 && d.nick is string && d.nick.size() <= 12
                 && d.className is string && d.className.size() <= 40));
      }
      allow get: if true;
      allow list: if omrAdmin() || resource.data.visibility in ['public','anon']
        || (omrStaffOrAdmin() && resource.data.visibility == 'staff');
      allow create: if omrAdmin() || postOk();
      allow update: if omrAdmin() || (omrStaffOrAdmin() && resource.data.visibility in ['public','anon','staff']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reply']));
      allow delete: if omrAdmin();
    }
    // 글쓴이 (익명 글 포함) — 선생님만 읽음
    match /boardAuthors/{id} {
      allow read: if omrAdmin();
      allow create: if omrAdmin() || (request.resource.data.keys().hasOnly(['sid','name','className','createdAt'])
        && request.resource.data.sid is string
        && exists(/databases/$(database)/documents/omrStudents/$(request.resource.data.sid))
        && request.resource.data.name is string && request.resource.data.name.size() <= 20
        && request.resource.data.className is string && request.resource.data.className.size() <= 40
        && request.resource.data.createdAt == request.time
        && existsAfter(/databases/$(database)/documents/boardPosts/$(id)));
      allow update, delete: if omrAdmin();
    }
    // 학생별 내가 쓴 글 id 목록 (학생 코드로만 접근)
    match /boardLinks/{code} {
      allow get: if true;
      allow list: if omrAdmin();
      allow write: if omrAdmin() || (exists(/databases/$(database)/documents/omrCodes/$(code))
        && request.resource.data.keys().hasOnly(['items'])
        && request.resource.data.items is list && request.resource.data.items.size() <= 200);
    }

    // 학생 코드 → 이름/반. 코드를 아는 사람만 단건 조회 가능 (목록 조회 불가)
    match /omrCodes/{code} {
      allow get: if true;
      allow list: if omrStaffOrAdmin();   // 조교도 반 명단(이름·반)은 볼 수 있음. 연락처는 omrStudents라 계속 관리자만
      allow write: if omrAdmin();
    }

    // 시험 정보 (정답 없음). 누구나 읽기, 관리자만 쓰기
    match /omrExams/{examId} {
      allow read: if true;
      allow write: if omrAdmin();
    }

    // 정답표 — 관리자만
    match /omrKeys/{examId} {
      allow read, write: if omrAdmin();
    }

    // 답안 제출. 문서 ID = {examId}_{학생코드}
    match /omrSubmissions/{subId} {
      function exam() {
        return get(/databases/$(database)/documents/omrExams/$(request.resource.data.examId)).data;
      }
      function validStudentWrite() {
        let d = request.resource.data;
        let codePath = /databases/$(database)/documents/omrCodes/$(d.code);
        return subId == d.examId + '_' + d.code
          && exists(codePath)
          && d.name == get(codePath).data.name
          && d.className == get(codePath).data.className
          // 응시 대상: 대상을 고른 시험은 고른 반 + 개별로 고른 학생, 예전 시험은 시험의 반
          && ('classNames' in exam()
              ? (d.className in exam().classNames || d.code in exam().targetCodes)
              : exam().className == d.className)
          && exam().status == 'open'
          && (exam().dueAt == null || request.time < exam().dueAt)
          && d.keys().hasOnly(['examId', 'code', 'name', 'className', 'answers',
                               'status', 'savedAt', 'submittedAt'])
          && d.answers is map
          && d.status in ['draft', 'submitted']
          && d.savedAt == request.time
          && (d.status == 'draft' || d.submittedAt == request.time);
      }
      allow get: if true;               // 문서 ID(=학생코드)를 알아야만 읽을 수 있음
      allow list: if omrAdmin();
      allow create: if omrAdmin() || validStudentWrite();
      // 최종 제출(submitted) 이후에는 학생이 수정할 수 없음
      allow update: if omrAdmin() || (resource.data.status == 'draft' && validStudentWrite());
      allow delete: if omrAdmin();
    }

    // 개인 성적표. 문서 ID = 무작위 토큰(링크). 결과 '공개' 상태일 때만 열람 가능
    match /omrReports/{token} {
      allow get: if omrAdmin() ||
        get(/databases/$(database)/documents/omrExams/$(resource.data.examId)).data.status == 'published';
      allow list, write: if omrAdmin();
    }

    // ───────── 재시험 — 관리자만 ─────────
    match /omrRetests/{id} {
      allow read, write: if omrAdmin();
    }

    // ───────── 오답 클리닉 ─────────
    // 유사 문항 은행 (정답 포함) — 관리자만
    match /omrBank/{id} {
      allow read, write: if omrAdmin();
    }
    // 학습지 (문항 내용만, 정답 없음). 문서 ID가 무작위라 링크를 아는 학생만 읽음
    match /omrClinics/{id} {
      allow get: if true;
      allow list, write: if omrAdmin();
    }
    match /omrClinicKeys/{id} {
      allow read, write: if omrAdmin();
    }
    // 학습지 답안. 문서 ID = 학습지 ID
    match /omrClinicSubs/{clinicId} {
      function clinicWrite() {
        let d = request.resource.data;
        let c = get(/databases/$(database)/documents/omrClinics/$(clinicId)).data;
        return d.clinicId == clinicId && d.code == c.code && c.status == 'open'
          && d.keys().hasOnly(['clinicId', 'code', 'answers', 'status', 'savedAt', 'submittedAt'])
          && d.answers is map
          && d.status in ['draft', 'submitted']
          && d.savedAt == request.time
          && (d.status == 'draft' || d.submittedAt == request.time);
      }
      allow get: if true;
      allow list, delete: if omrAdmin();
      allow create: if omrAdmin() || clinicWrite();
      allow update: if omrAdmin() || (resource.data.status == 'draft' && clinicWrite());
    }
    match /omrClinicResults/{id} {
      allow get: if true;
      allow list, write: if omrAdmin();
    }

    // ───────── 과제 ─────────
    match /omrAssignments/{id} {
      allow read: if true;
      allow write: if omrAdmin();
    }
    // 과제 제출. 문서 ID = {과제ID}_{학생코드}
    // 학생 상태: in_progress(진행 중) / submitted(제출 완료), 관리자 상태: revise(보완 필요) / approved(확인 완료)
    match /omrAssignSubs/{subId} {
      function assignWrite() {
        let d = request.resource.data;
        let codePath = /databases/$(database)/documents/omrCodes/$(d.code);
        let a = get(/databases/$(database)/documents/omrAssignments/$(d.assignmentId)).data;
        return subId == d.assignmentId + '_' + d.code
          && exists(codePath)
          && d.name == get(codePath).data.name
          && d.className == get(codePath).data.className
          && a.className == d.className
          && a.status == 'open'
          && d.keys().hasOnly(['assignmentId', 'code', 'name', 'className', 'files', 'memo', 'status',
                               'savedAt', 'submittedAt', 'feedback', 'reviewedAt'])
          && d.files is list && d.files.size() <= 20
          && d.memo is string && d.memo.size() <= 1000
          && d.status in ['in_progress', 'submitted']
          && d.savedAt == request.time
          && (d.status != 'submitted' || d.submittedAt == request.time);
      }
      allow get: if true;
      allow list, delete: if omrAdmin();
      allow create: if omrAdmin() ||
        (assignWrite() && !request.resource.data.keys().hasAny(['feedback', 'reviewedAt']));
      // 제출 완료·확인 완료 뒤에는 학생이 못 바꾸고, 보완 요청을 받으면 다시 제출 가능. 선생님 피드백은 학생이 못 고침
      allow update: if omrAdmin() ||
        (resource.data.status in ['in_progress', 'revise'] && assignWrite()
         && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['feedback', 'reviewedAt']));
    }

    // ───────── 데일리 리포트 (선생님 + 조교) ─────────
    // 조교 계정: 문서 ID = 조교 로그인 UID. 관리자만 만들고 지움
    match /omrStaff/{uid} {
      allow get: if omrAdmin() || (request.auth != null && request.auth.uid == uid);
      allow list, write: if omrAdmin();
    }
    // 조교 비밀번호 (선생님 확인용) — 선생님만
    match /staffSecrets/{uid} {
      allow read, write: if omrAdmin();
    }
    // 수업(반·날짜) 기록
    match /dailyLessons/{id} {
      allow read, write: if omrStaffOrAdmin();
    }
    // 학생별 입력값. 문서 ID = {수업ID}_{학생코드}
    match /dailyEntries/{id} {
      allow read, write: if omrStaffOrAdmin();
    }
    // 발행된 리포트. 문서 ID = 무작위 토큰(링크)
    match /dailyReports/{token} {
      allow get: if true;
      allow list, write: if omrStaffOrAdmin();
    }
    // 학생 코드별 리포트 목록 (학생 포털용). 문서 ID = 학생코드
    match /dailyReportLinks/{code} {
      allow get: if true;
      allow list, write: if omrStaffOrAdmin();
    }

    // ───────── 공통: 학생 코드 확인 (코드가 등록돼 있고 이름·반이 일치) ─────────
    function stuOk(d) {
      let p = /databases/$(database)/documents/omrCodes/$(d.code);
      return d.code is string && exists(p)
        && d.name == get(p).data.name && d.className == get(p).data.className;
    }

    // ───────── 클리닉 예약 ─────────
    // 시간표(슬롯). 학생은 예약/취소할 때 count(예약 인원)만 1씩 바꿀 수 있음
    match /clinicSlots/{slotId} {
      allow read: if true;
      allow create, delete: if omrStaffOrAdmin();
      allow update: if omrStaffOrAdmin() || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['count'])
        && resource.data.status == 'open'
        && request.resource.data.count is int
        && request.resource.data.count >= 0
        && request.resource.data.count <= resource.data.capacity
        && (request.resource.data.count == resource.data.count + 1
            || request.resource.data.count == resource.data.count - 1));
    }
    // 예약. 문서 ID = {슬롯ID}_{학생코드}. 예약·취소는 슬롯 count 변경과 한 번에(batch) 해야 함
    match /clinicBookings/{bid} {
      function slotPath(){ return /databases/$(database)/documents/clinicSlots/$(request.resource.data.slotId); }
      function bookOk() {
        let d = request.resource.data;
        let s = get(slotPath()).data;
        return bid == d.slotId + '_' + d.code && stuOk(d)
          && s.status == 'open' && (s.className == '전체' || s.className == d.className
              || (s.classNames is list && d.className in s.classNames))   // 여러 반 대상 클리닉
          && getAfter(slotPath()).data.count == s.count + 1
          && d.keys().hasOnly(['slotId', 'code', 'name', 'className', 'memo', 'bookedAt'])
          && d.memo is string && d.memo.size() <= 200
          && d.bookedAt == request.time;
      }
      allow get: if true;
      allow list: if omrStaffOrAdmin();
      allow create: if omrStaffOrAdmin() || bookOk();
      allow update: if omrStaffOrAdmin();
      allow delete: if omrStaffOrAdmin() || (
        getAfter(/databases/$(database)/documents/clinicSlots/$(resource.data.slotId)).data.count
          == get(/databases/$(database)/documents/clinicSlots/$(resource.data.slotId)).data.count - 1);
    }

    // ───────── 영상 강의 ─────────
    match /lectures/{id} {
      allow read: if true;
      allow write: if omrStaffOrAdmin();
    }
    // 시청 기록. 문서 ID = {강의ID}_{학생코드}
    match /lectureViews/{vid} {
      function viewOk() {
        let d = request.resource.data;
        return vid == d.lectureId + '_' + d.code && stuOk(d)
          && exists(/databases/$(database)/documents/lectures/$(d.lectureId))
          && d.keys().hasOnly(['lectureId', 'code', 'name', 'className', 'segments', 'percent',
                               'watchedSec', 'duration', 'completed', 'firstAt', 'lastAt'])
          && d.percent is number && d.percent >= 0 && d.percent <= 100
          && d.segments is string && d.segments.size() <= 4000
          && d.lastAt == request.time;
      }
      allow get: if true;
      allow list: if omrStaffOrAdmin();
      allow create: if omrStaffOrAdmin() || viewOk();
      allow update: if omrStaffOrAdmin() || (viewOk() && request.resource.data.firstAt == resource.data.firstAt);
      allow delete: if omrStaffOrAdmin();
    }

    // ───────── 질문하기 ─────────
    // 문서 ID는 무작위라 링크(ID)를 아는 학생만 읽음. 답변은 선생님·조교만
    match /questions/{qid} {
      allow get: if true;
      // 질문 목록은 선생님만. 조교는 선생님이 맡긴(assignee) 질문만 보고 답변(status·answer)만 바꿀 수 있어요
      allow list: if omrAdmin() || (omrStaffOrAdmin() && resource.data.assignee == request.auth.uid);
      allow update: if omrAdmin() || (omrStaffOrAdmin() && resource.data.assignee == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'answer']));
      allow delete: if omrAdmin();
      allow create: if stuOk(request.resource.data)
        && request.resource.data.keys().hasOnly(['code', 'name', 'className', 'subject', 'text', 'files', 'status', 'createdAt'])
        && request.resource.data.text is string && request.resource.data.text.size() <= 3000
        && request.resource.data.files is list && request.resource.data.files.size() <= 6
        && request.resource.data.status == 'open'
        && request.resource.data.createdAt == request.time;
    }
    // 학생별 질문 목록. 문서 ID = 학생코드
    match /questionLinks/{code} {
      allow get: if true;
      allow list: if omrStaffOrAdmin();
      allow write: if omrStaffOrAdmin() || (
        exists(/databases/$(database)/documents/omrCodes/$(code))
        && request.resource.data.keys().hasOnly(['items'])
        && request.resource.data.items is list && request.resource.data.items.size() <= 300);
    }

    // ───────── 등원 체크 ─────────
    // 문서 ID = {날짜}_{학생코드}. 데스크 태블릿에서 코드로 등원/하원 기록
    match /attendance/{aid} {
      function inOk() {
        let d = request.resource.data;
        return aid == d.date + '_' + d.code && stuOk(d)
          && d.keys().hasOnly(['date', 'code', 'name', 'className', 'inAt', 'status'])
          && d.status == 'in' && d.inAt == request.time;
      }
      allow get: if true;
      allow list, delete: if omrStaffOrAdmin();
      allow create: if omrStaffOrAdmin() || inOk();
      allow update: if omrStaffOrAdmin() || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['outAt', 'status'])
        && resource.data.status == 'in' && request.resource.data.status == 'out'
        && request.resource.data.outAt == request.time);
    }

    // ───────── 집중 타이머 ─────────
    // 학생이 세션을 끝낼 때 한 건씩 추가만 가능. 목록·수정·삭제는 선생님·조교만
    match /studySessions/{sid} {
      function sessOk() {
        let d = request.resource.data;
        return stuOk(d)
          && d.keys().hasOnly(['code', 'name', 'className', 'date', 'startedAt', 'endedAt', 'plannedSec',
                               'elapsedSec', 'focusSec', 'awayCount', 'awaySec', 'mode', 'completed'])
          && d.date is string && d.date.size() == 10
          && d.plannedSec is int && d.plannedSec > 0 && d.plannedSec <= 14400
          && d.elapsedSec is int && d.elapsedSec >= 0 && d.elapsedSec <= d.plannedSec
          && d.focusSec is int && d.focusSec >= 0 && d.focusSec <= d.elapsedSec
          && d.awayCount is int && d.awayCount >= 0 && d.awaySec is int && d.awaySec >= 0
          && d.mode in ['warn', 'pause'] && d.completed is bool
          && d.endedAt == request.time;
      }
      allow create: if sessOk();
      allow read, update, delete: if omrStaffOrAdmin();
    }

    // ───────── 스터디 플래너 ─────────
    // 하루 한 장. 문서 ID = {학생코드}_{YYYY-MM-DD}. 학생이 코드로 작성, 선생님·조교는 목록 조회
    match /planners/{pid} {
      function planOk() {
        let d = request.resource.data;
        return stuOk(d) && pid == d.code + '_' + d.date
          && d.keys().hasOnly(['code', 'name', 'className', 'date', 'pledge', 'todos', 'grid', 'feedback', 'sticker',
                               'studyMin', 'done', 'total', 'updatedAt', 'tdone', 'closed', 'closedAuto',
                               'ttodos', 'tcomment', 'tstamp', 'tby', 'tat'])
          && (!('tdone' in d) || (d.tdone is list && d.tdone.size() <= 40))
          && d.date is string && d.date.size() == 10
          && d.pledge is string && d.pledge.size() <= 60
          && d.todos is list && d.todos.size() <= 40
          && d.grid is string && d.grid.size() <= 200
          && d.feedback is string && d.feedback.size() <= 300
          && d.sticker is string && d.sticker.size() <= 16
          && d.studyMin is int && d.studyMin >= 0 && d.studyMin <= 1440
          && d.updatedAt == request.time;
      }
      // 선생님 칸(ttodos·코멘트·도장)은 학생이 만들거나 바꿀 수 없음
      allow get: if true;
      allow list, delete: if omrStaffOrAdmin();
      allow create: if omrStaffOrAdmin() ||
        (planOk() && !request.resource.data.keys().hasAny(['ttodos', 'tcomment', 'tstamp', 'tby', 'tat']));
      allow update: if omrStaffOrAdmin() ||
        (planOk() && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['ttodos', 'tcomment', 'tstamp', 'tby', 'tat']));
    }
    // 플래너 설정(D-day). 문서 ID = 학생코드
    match /plannerMeta/{code} {
      allow get: if true;
      allow list: if omrStaffOrAdmin();
      allow write: if exists(/databases/$(database)/documents/omrCodes/$(code))
        && request.resource.data.code == code
        && request.resource.data.keys().hasOnly(['code', 'dday', 'updatedAt']);
    }

    // ───────── 순공 랭킹판 ─────────
    // 타이머 세션이 저장될 때 같은 묶음(batch)으로만 더해짐. 학생 코드 대신 studentId·가린 이름만 공개
    // 문서 ID = {기간키}_{studentId}, 기간키 = d2026-10-01(하루) · w2026-09-28(주, 월요일) · m2026-10(달)
    match /studyBoard/{bid} {
      function boardOk() {
        let d = request.resource.data;
        let sp = /databases/$(database)/documents/studySessions/$(d.lastSid);
        let s = getAfter(sp).data;
        let c = get(/databases/$(database)/documents/omrCodes/$(s.code)).data;
        return !exists(sp) && existsAfter(sp)
          && c.studentId == d.sid && c.className == d.className
          && bid == d.key + '_' + d.sid
          && (d.key == 'd' + s.date || d.key == 'm' + s.date[0:7] || d.key.matches('w[0-9]{4}-[0-9]{2}-[0-9]{2}'))
          && d.keys().hasOnly(['key', 'sid', 'nick', 'className', 'focusSec', 'sessions', 'lastSid', 'updatedAt'])
          && d.nick is string && d.nick.size() <= 12
          && d.focusSec == (resource == null ? 0 : resource.data.focusSec) + s.focusSec
          && d.sessions == (resource == null ? 0 : resource.data.sessions) + 1
          && d.updatedAt == request.time;
      }
      allow read: if true;
      allow create, update: if boardOk();
      allow delete: if omrStaffOrAdmin();
    }

    // ───────── 학생 기록 (상담·특이사항) — 선생님·조교만 ─────────
    match /studentNotes/{id} {
      allow read, write: if omrStaffOrAdmin();
    }

    // ───────── 성적표 확장 ─────────
    // 학생별 누적 성적표 목록. 문서 ID = 학생코드
    match /omrReportLinks/{code} {
      allow get: if true;
      allow list, write: if omrStaffOrAdmin();
    }
    // 유형 분류(대분류 › 중분류 › 유형). 문서 하나(tree)
    match /omrTypes/{id} {
      allow read: if omrStaffOrAdmin();
      allow write: if omrAdmin();
    }
