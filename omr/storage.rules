rules_version = '2';
// ─────────────────────────────────────────────────────────────
// 엄형국 수학 — Firebase Storage 보안 규칙 (전체)
//
// 적용 방법: Firebase 콘솔 → Storage → 규칙 탭의 내용을 "전부 지우고" 이 파일 전체를 붙여 넣은 뒤 게시하세요.
//   (게시할 때 "Cloud Firestore 접근 권한"을 묻는 창이 뜨면 허용해야 학생 코드 확인이 됩니다)
// ⚠ 아래 omrAdmin() 안의 ADMIN_EMAIL 한 곳을 선생님 로그인 이메일로 바꾸세요.
// ─────────────────────────────────────────────────────────────
service firebase.storage {
  match /b/{bucket}/o {

    function omrAdmin() {
      return request.auth != null && request.auth.token.email == 'ADMIN_EMAIL';
    }

    // 과제 파일: omrAssign/{과제ID}/{학생코드}/{파일}
    // 학생은 로그인 없이 올리되, 등록된 코드 + 자기 반의 열린 과제 + 10MB 이하 사진/PDF만 허용
    match /omrAssign/{assignId}/{code}/{file} {
      allow read, delete: if omrAdmin();
      allow create: if request.resource.size < 10 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*') || request.resource.contentType == 'application/pdf')
        && firestore.exists(/databases/(default)/documents/omrCodes/$(code))
        && firestore.get(/databases/(default)/documents/omrAssignments/$(assignId)).data.status == 'open'
        && firestore.get(/databases/(default)/documents/omrAssignments/$(assignId)).data.className
           == firestore.get(/databases/(default)/documents/omrCodes/$(code)).data.className;
    }

    // 유사 문항 이미지: 학습지를 푸는 학생이 볼 수 있게 읽기 공개, 쓰기는 관리자만
    match /omrBank/{id}/{file} {
      allow read: if true;
      allow write: if omrAdmin();
    }

    // 데일리 리포트 첨부(분석지 사진·PDF): dailyFiles/{수업ID}/{파일}
    // 리포트 링크를 받은 학생·학부모가 볼 수 있게 읽기 공개(파일 이름은 무작위), 쓰기는 선생님·조교만
    match /dailyFiles/{lessonId}/{file} {
      allow read: if true;
      allow delete: if omrAdmin() || (request.auth != null
        && firestore.exists(/databases/(default)/documents/omrStaff/$(request.auth.uid)));
      allow create: if request.resource.size < 15 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*') || request.resource.contentType == 'application/pdf')
        && (omrAdmin() || (request.auth != null
        && firestore.exists(/databases/(default)/documents/omrStaff/$(request.auth.uid))));
    }

    // 질문 사진: qna/{학생코드}/{파일} — 등록된 코드만 10MB 이하 사진 업로드
    match /qna/{code}/{file} {
      allow read: if true;
      allow create: if request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*')
        && firestore.exists(/databases/(default)/documents/omrCodes/$(code));
      allow delete: if omrAdmin() || (request.auth != null
        && firestore.exists(/databases/(default)/documents/omrStaff/$(request.auth.uid)));
    }
    // 답변 사진·강의 자료: staffFiles/{종류}/{파일} — 선생님·조교만 올림
    match /staffFiles/{kind}/{file} {
      allow read: if true;
      allow create, delete: if omrAdmin() || (request.auth != null
        && firestore.exists(/databases/(default)/documents/omrStaff/$(request.auth.uid)));
    }

    // 게시판 사진: board/{글ID}/{파일} — 글을 올리기 직전에만(그 글이 아직 없을 때) 8MB 이하 사진 업로드
    // 경로에 학생 코드를 넣지 않아 익명 글도 안전해요
    match /board/{postId}/{file} {
      allow read: if true;
      allow create: if request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*')
        && !firestore.exists(/databases/(default)/documents/boardPosts/$(postId));
      allow delete: if omrAdmin();
    }

    // 메인 홈페이지 자료실: 커리큘럼·진로 자료 — 누구나 보기, 선생님만 올리기·지우기
    match /curriculum/{rest=**} {
      allow read: if true;
      allow write: if omrAdmin();
    }
    match /career/{rest=**} {
      allow read: if true;
      allow write: if omrAdmin();
    }
  }
}
